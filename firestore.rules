rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /notes/{id} {
      allow read: if true;
      allow create: if request.resource.data.t is string
                    && request.resource.data.t.size() > 0
                    && request.resource.data.t.size() <= 160
                    && request.resource.data.from.size() <= 24;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['x','y'])
                    && request.resource.data.x is number && request.resource.data.x >= 0 && request.resource.data.x <= 100
                    && request.resource.data.y is number && request.resource.data.y >= 0 && request.resource.data.y <= 100;
      allow delete: if false;
    }
  }
}
